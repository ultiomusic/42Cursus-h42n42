<ocsigen>
  <server>
    <port>8080</port>
    <logdir>/tmp</logdir>
    <datadir>/tmp</datadir>
    <charset>utf-8</charset>
    <commandpipe>/tmp/h42n42-cmd</commandpipe>
    <extension findlib-package="ocsigenserver.ext.staticmod" />
    <extension findlib-package="ocsipersist-sqlite" />
    <extension findlib-package="eliom.server" />
    <host hostfilter="*" defaulthostname="localhost">
      <static dir="static" />
      <eliommodule module="h42n42.cma" />
      <eliom />
    </host>
  </server>
</ocsigen>
