module%client Infection = struct
  let contact (a:Creet.t) (b:Creet.t) =
    let ax, ay = Creet.center a and bx, by = Creet.center b in
    let dx = ax -. bx and dy = ay -. by in
    let rr = (Creet.radius a +. Creet.radius b) in
    (dx *. dx +. dy *. dy) <= rr *. rr

  let tick_pair (a:Creet.t) (b:Creet.t) =
    if a.grabbed || b.grabbed then ()
    else match a.state, b.state with
      | Infected, Healthy ->
          if contact a b && Random.float 1.0 < !(Params.infection_prob) then Creet.infect b
      | Healthy, Infected ->
          if contact a b && Random.float 1.0 < !(Params.infection_prob) then Creet.infect a
      | _ -> ()
end

module%client Behavior = struct
  let mean_speed_boost = 1.15 /. Params.slow_on_infect
  let speed_mult (c : Creet.t) =
    match c.kind, c.state with
    | Mean,    Infected -> mean_speed_boost
    | Berserk, Infected -> 1.0
    | _ -> 1.0

  let is_alive (c : Creet.t) = c.state <> Dead

  let nearest ?(pred=(fun (_:Creet.t)->true)) (self : Creet.t) : Creet.t option =
    let sx, sy = Creet.center self in
    let best : (Creet.t * float) option ref = ref None in
    World.all ()
    |> List.iter (fun o ->
         if o != self && is_alive o && pred o then (
           let ox, oy = Creet.center o in
           let dx = sx -. ox and dy = sy -. oy in
           let d2 = dx*.dx +. dy*.dy in
           match !best with None -> best := Some (o, d2) | Some (_, bd2) -> if d2 < bd2 then best := Some (o, d2)
         ));
    match !best with Some (o, _) -> Some o | None -> None

  let nudge_towards (c : Creet.t) (tx,ty) strength =
    let cx,cy = Creet.center c in
    let dx = tx -. cx and dy = ty -. cy in
    let d  = max 0.001 (sqrt (dx *. dx +. dy *. dy)) in
    let ux, uy = dx /. d, dy /. d in
    let cur_speed = sqrt (c.vx *. c.vx +. c.vy *. c.vy) in
    let desired = max 0.6 cur_speed in
    let nx = (1. -. strength) *. c.vx +. strength *. ux *. desired in
    let ny = (1. -. strength) *. c.vy +. strength *. uy *. desired in
    c.vx <- nx; c.vy <- ny

  let update (c : Creet.t) =
    match c.state, c.kind with
    | Infected, Mean ->
        if Random.float 1.0 < 0.30 then
          (match nearest c ~pred:(fun o -> o.state = Healthy) with
           | Some t -> nudge_towards c (Creet.center t) 0.12
           | None -> ())
    | _ -> ()
end

module%client Movement = struct
  open Js_of_ocaml

  let bounds () =
    let w = float_of_int Dom_html.window##.innerWidth
    and h = float_of_int Dom_html.window##.innerHeight in
    (w, h)

  let bounce (c:Creet.t) =
    let w, h = bounds () in
    let sz = Creet.size c in
    if c.x < 0. then (c.x <- 0.; c.vx <- -. c.vx)
    else if c.x +. sz > w then (c.x <- w -. sz; c.vx <- -. c.vx);
    if c.y < 0. then (c.y <- 0.; c.vy <- -. c.vy)
    else if c.y +. sz > h then (c.y <- h -. sz; c.vy <- -. c.vy)

  let in_river (c:Creet.t) = c.y <= !(Params.river_h)
  let in_hospital (c:Creet.t) =
    let _, h = bounds () in
    (c.y +. Creet.size c) >= (h -. !(Params.hospital_h))

  let turn_tick (c:Creet.t) dt =
    c.next_turn <- c.next_turn -. dt;
    if c.next_turn <= 0. then (
      let ang = (Random.float 0.8 -. 0.4) in
      let ca = cos ang and sa = sin ang in
      let vx' = c.vx *. ca -. c.vy *. sa
      and vy' = c.vx *. sa +. c.vy *. ca in
      c.vx <- vx'; c.vy <- vy';
      c.next_turn <- !(Params.turn_min_s) +. Random.float (!(Params.turn_max_s) -. !(Params.turn_min_s))
    );
    if Random.float 1.0 < !(Params.jitter_prob) then (
      let a = (Random.float 0.6 -. 0.3) in
      let ca = cos a and sa = sin a in
      let vx' = c.vx *. ca -. c.vy *. sa
      and vy' = c.vx *. sa +. c.vy *. ca in
      c.vx <- vx'; c.vy <- vy'
    )

  let clamp x lo hi = max lo (min hi x)
  let rand_repro_delay () =
    !(Params.reproduce_min) +. Random.float (!(Params.reproduce_max) -. !(Params.reproduce_min))

  let rec reproduction_loop (parent : Creet.t) : unit Lwt.t =
    if parent.epoch <> !Session.epoch then Lwt.return_unit
    else if parent.state <> Healthy then Lwt.return_unit
    else if not (World.any_healthy ()) then Lwt.return_unit
    else (
      let%lwt () = Js_of_ocaml_lwt.Lwt_js.sleep (rand_repro_delay ()) in
      if parent.epoch = !Session.epoch
         && parent.state = Healthy
         && World.any_healthy ()
         && World.count () < !(Params.max_creets) then (
        let w = float_of_int Dom_html.window##.innerWidth
        and h = float_of_int Dom_html.window##.innerHeight in
        let dx = (Random.float 30.) -. 15. in
        let dy = (Random.float 30.) -. 15. in
        let sz = Creet.size parent in
        let x = clamp (parent.x +. dx) 0. (w -. sz)
        and y = clamp (parent.y +. dy) 0. (h -. sz) in
        let id = Ids.next () in
        let child = Creet.create ~id ~x ~y () in
        World.add child;
        start child;
        start_reproduction child;
        Stats.refresh ();
      );
      reproduction_loop parent
    )

  and start_reproduction (c : Creet.t) = Lwt.async (fun () -> reproduction_loop c)

  and loop (c : Creet.t) : unit Lwt.t =
    if c.epoch <> !Session.epoch then Lwt.return_unit
    else if c.state = Dead then Lwt.return_unit
    else (
      let%lwt () = Runtime.wait_unpaused () in
      let spd_scale = !(Difficulty.base) *. Behavior.speed_mult c in

      let died_now = ref false in
      (match c.life_left, c.state with
       | Some t, Infected ->
           let t' = t -. 0.016 in
           c.life_left <- Some t';
           (match c.kind with
            | Berserk ->
                let progress = max 0.0 (min 1.0 ((Const.infection_life -. t') /. Const.infection_life)) in
                let scale = 1.0 +. (Const.berserk_max -. 1.0) *. progress in
                Creet.set_size_scale c scale
            | _ -> ());
           if t' <= 0.0 then (
             c.state <- Dead;
             Js_of_ocaml.Js.Opt.iter c.elt##.parentNode (fun p ->
               ignore (Js_of_ocaml.Dom.removeChild p (c.elt :> Js_of_ocaml.Dom.node Js.t)));
             World.remove c;
             Stats.on_death ();
             died_now := true
           )
       | _ -> ());

      if !died_now then Lwt.return_unit
      else (
        Behavior.update c;

        if not c.grabbed then (
          turn_tick c 0.016;
          c.x <- c.x +. (c.vx *. spd_scale);
          c.y <- c.y +. (c.vy *. spd_scale);
          bounce c;
          if c.state = Healthy && in_river c then Creet.infect c
        );

        Creet.apply_visual c;

        if (World.count () = 0) || (World.count_healthy () = 0) then (
          Stats.refresh (); Stats.show_game_over (); Lwt.return_unit
        ) else (
          let%lwt () = Js_of_ocaml_lwt.Lwt_js.sleep 0.016 in
          loop c
        )
      )
    )

  and start (c : Creet.t) = Lwt.async (fun () -> loop c)
end

(* ─────────────────────────────────────────────────────────────────────────── *)
module%client Quad = struct
  type rect = { x: float; y: float; w: float; h: float }

  let contains_point (r:rect) (px,py) =
    px >= r.x && px <= r.x +. r.w && py >= r.y && py <= r.y +. r.h

  let intersects (a:rect) (b:rect) =
    not (b.x > a.x +. a.w || b.x +. b.w < a.x || b.y > a.y +. a.h || b.y +. b.h < a.y)

  type node = {
    bounds   : rect;
    capacity : int;
    mutable points : Creet.t list;
    mutable nw : node option;
    mutable ne : node option;
    mutable sw : node option;
    mutable se : node option;
    mutable divided : bool;
  }

  let create bounds capacity =
    { bounds; capacity; points=[]; nw=None; ne=None; sw=None; se=None; divided=false }

  let subdivide n =
    let hw = n.bounds.w /. 2. and hh = n.bounds.h /. 2. in
    let x = n.bounds.x and y = n.bounds.y in
    let mk x y = create { x; y; w = hw; h = hh } n.capacity in
    n.nw <- Some (mk x y);
    n.ne <- Some (mk (x +. hw) y);
    n.sw <- Some (mk x (y +. hh));
    n.se <- Some (mk (x +. hw) (y +. hh));
    n.divided <- true

  let rec insert n (c:Creet.t) =
    let px, py = Creet.center c in
    if not (contains_point n.bounds (px,py)) then false
    else if (List.length n.points) < n.capacity && not n.divided then (
      n.points <- c :: n.points; true
    ) else (
      if not n.divided then subdivide n;
      let inserted =
        (match n.nw with Some q when insert q c -> true | _ -> false)
        || (match n.ne with Some q when insert q c -> true | _ -> false)
        || (match n.sw with Some q when insert q c -> true | _ -> false)
        || (match n.se with Some q when insert q c -> true | _ -> false)
      in
      if not inserted then n.points <- c :: n.points;
      true
    )

  let rec query n (range:rect) (acc:Creet.t list ref) =
    if not (intersects n.bounds range) then ()
    else (
      List.iter (fun (c:Creet.t) ->
        let px,py = Creet.center c in
        if contains_point range (px,py) then acc := c :: !acc) n.points;
      if n.divided then (
        (match n.nw with Some q -> query q range acc | None -> ());
        (match n.ne with Some q -> query q range acc | None -> ());
        (match n.sw with Some q -> query q range acc | None -> ());
        (match n.se with Some q -> query q range acc | None -> ())
      )
    )
end

module%client Collider = struct
  open Quad
  let max_other_radius = (Const.base_size *. Const.berserk_max) /. 2.0

  let build_tree () =
    let w = float_of_int Js_of_ocaml.Dom_html.window##.innerWidth
    and h = float_of_int Js_of_ocaml.Dom_html.window##.innerHeight in
    let root = create { x=0.; y=0.; w; h } 8 in
    World.all () |> List.iter (fun (c:Creet.t) -> if c.state <> Dead then ignore (insert root c));
    root

  let process_pairs root =
    World.all ()
    |> List.iter (fun (c:Creet.t) ->
         if c.state <> Dead then (
           let cx, cy = Creet.center c in
           let r = Creet.radius c +. max_other_radius in
           let range = { x = cx -. r; y = cy -. r; w = 2. *. r; h = 2. *. r } in
           let acc : Creet.t list ref = ref [] in
           query root range acc;
           List.iter (fun (o:Creet.t) ->
             if o != c && o.id > c.id && o.state <> Dead then (
               Infection.tick_pair c o; Infection.tick_pair o c;
             )
           ) !acc
         )
       )

  let start () =
    Lwt.async (fun () ->
      let rec loop () =
        if !(Runtime.game_over) || not !(Runtime.game_started) then Lwt.return_unit
        else (
          let%lwt () = Runtime.wait_unpaused () in
          let root = build_tree () in
          process_pairs root;
          let%lwt () = Js_of_ocaml_lwt.Lwt_js.sleep 0.016 in
          loop ()
        )
      in loop ()
    )
end

module%client Input = struct
  open Js_of_ocaml

  type drag = { mutable active: bool; mutable target: Creet.t option; mutable offx: float; mutable offy: float }
  let d = { active=false; target=None; offx=0.; offy=0. }

  let element_pos (e:Dom_html.element Js.t) =
    let r = e##getBoundingClientRect in (r##.left, r##.top)

  let mouse_pos_in (e:Dom_html.element Js.t) (ev:Dom_html.mouseEvent Js.t) =
    let ex, ey = element_pos e in (float_of_int ev##.clientX -. ex, float_of_int ev##.clientY -. ey)

  let try_pick (x:float) (y:float) : Creet.t option =
    let within (c:Creet.t) =
      let cx, cy = Creet.center c in
      let r = Creet.radius c in
      let dx = x -. cx and dy = y -. cy in (dx *. dx +. dy *. dy) <= r *. r
    in
    World.all () |> List.find_opt within

  let install () =
    let sim_el = Js_of_ocaml.Dom_html.getElementById "sim" in
    let open Js_of_ocaml_lwt in

    Lwt.async (fun () ->
      Lwt_js_events.mousedowns (sim_el :> Dom_html.eventTarget Js.t) (fun ev _ ->
        if not !(Runtime.game_over) && !(Runtime.game_started) then (
          let x, y = mouse_pos_in sim_el ev in
          match try_pick x y with
          | None -> Lwt.return_unit
          | Some c ->
              d.active <- true; d.target <- Some c; c.grabbed <- true; Creet.apply_classes c;
              let cx, cy = Creet.center c in
              d.offx <- x -. cx; d.offy <- y -. cy;
              Lwt.return_unit
        ) else Lwt.return_unit));

    Lwt.async (fun () ->
      Lwt_js_events.mousemoves Dom_html.document (fun ev _ ->
        match d.target with
        | Some c when d.active ->
            let w = float_of_int Dom_html.window##.innerWidth
            and h = float_of_int Dom_html.window##.innerHeight in
            let x, y = float_of_int ev##.clientX, float_of_int ev##.clientY in
            let nx = x -. d.offx -. Creet.radius c
            and ny = y -. d.offy -. Creet.radius c in
            let nx = max 0. (min (w -. Creet.size c) nx)
            and ny = max 0. (min (h -. Creet.size c) ny) in
            c.x <- nx; c.y <- ny; Creet.apply_visual c; Lwt.return_unit
        | _ -> Lwt.return_unit));

    Lwt.async (fun () ->
      Lwt_js_events.mouseups Dom_html.document (fun _ _ ->
        match d.target with
        | Some c ->
            d.active <- false; d.target <- None; c.grabbed <- false; Creet.apply_classes c;
            if c.state = Infected && Movement.in_hospital c then Creet.heal c;
            Lwt.return_unit
        | None -> Lwt.return_unit));
    ()
end

(* ─────────────────────────────────────────────────────────────────────────── *)
module%client Settings = struct
  open Js_of_ocaml
  let make_sliders (p:Dom_html.divElement Js.t) =
    let open Js_of_ocaml_lwt in
    let set_attr (el: #Dom_html.element Js.t) k v = el##setAttribute (Js.string k) (Js.string v) in
    let add_row (p:Dom_html.divElement Js.t) (title:string)
      : Dom_html.divElement Js.t * Dom_html.element Js.t * Dom_html.inputElement Js.t =
      let doc = Dom_html.document in
      let row = Dom_html.createDiv doc in
      row##.className := Js.string "settings__row";
      let label = Dom_html.createSpan doc in
      label##.className := Js.string "settings__label";
      label##.textContent := Js.Opt.return (Js.string title);
      let value = Dom_html.createSpan doc in
      value##.className := Js.string "settings__value";
      Dom.appendChild (row :> Dom.node Js.t) (label :> Dom.node Js.t);
      Dom.appendChild (row :> Dom.node Js.t) (value :> Dom.node Js.t);
      let slider = Dom_html.createInput ~_type:(Js.string "range") doc in
      slider##.className := Js.string "settings__slider";
      Dom.appendChild (row :> Dom.node Js.t) (slider :> Dom.node Js.t);
      Dom.appendChild (p   :> Dom.node Js.t) (row   :> Dom.node Js.t);
      (row, (value :> Dom_html.element Js.t), slider)
    in
    let px_to_str f = Printf.sprintf "%d px" (int_of_float f) in

    (* River height *)
    let (_r1, v1, s1) = add_row p "River height (px)" in
    set_attr s1 "min" "0"; set_attr s1 "max" "240"; set_attr s1 "step" "5";
    set_attr s1 "value" (string_of_int (int_of_float !(Params.river_h)));
    v1##.textContent := Js.Opt.return (Js.string (px_to_str !(Params.river_h)));
    Lwt.async (fun () -> Lwt_js_events.inputs s1 (fun _ _ ->
      let v = float_of_string (Js.to_string s1##.value) in
      Params.river_h := v; Bands.set_heights ();
      v1##.textContent := Js.Opt.return (Js.string (px_to_str v)); Lwt.return_unit));

    (* Hospital height *)
    let (_r2, v2, s2) = add_row p "Hospital height (px)" in
    set_attr s2 "min" "40"; set_attr s2 "max" "300"; set_attr s2 "step" "5";
    set_attr s2 "value" (string_of_int (int_of_float !(Params.hospital_h)));
    v2##.textContent := Js.Opt.return (Js.string (px_to_str !(Params.hospital_h)));
    Lwt.async (fun () -> Lwt_js_events.inputs s2 (fun _ _ ->
      let v = float_of_string (Js.to_string s2##.value) in
      Params.hospital_h := v; Bands.set_heights ();
      v2##.textContent := Js.Opt.return (Js.string (px_to_str v)); Lwt.return_unit));

    (* Max creets *)
    let (_r3, v3, s3) = add_row p "Max creets" in
    set_attr s3 "min" "10"; set_attr s3 "max" "120"; set_attr s3 "step" "1";
    set_attr s3 "value" (string_of_int !(Params.max_creets));
    v3##.textContent := Js.Opt.return (Js.string (string_of_int !(Params.max_creets)));
    Lwt.async (fun () -> Lwt_js_events.inputs s3 (fun _ _ ->
      let v = int_of_string (Js.to_string s3##.value) in
      Params.max_creets := v;
      v3##.textContent := Js.Opt.return (Js.string (string_of_int v)); Lwt.return_unit));

    (* Initial creets *)
    let (_r4, v4, s4) = add_row p "Initial creets (at Play)" in
    set_attr s4 "min" "4"; set_attr s4 "max" "40"; set_attr s4 "step" "1";
    set_attr s4 "value" (string_of_int !(Params.initial_creets));
    v4##.textContent := Js.Opt.return (Js.string (string_of_int !(Params.initial_creets)));
    Lwt.async (fun () -> Lwt_js_events.inputs s4 (fun _ _ ->
      let v = int_of_string (Js.to_string s4##.value) in
      Params.initial_creets := v;
      v4##.textContent := Js.Opt.return (Js.string (string_of_int v)); Lwt.return_unit));
    ()
end

(* ─────────────────────────────────────────────────────────────────────────── *)
module%client Overlay = struct
  open Js_of_ocaml

  let init_bands () = Bands.init ()

  let init_pause_button () =
    let btn =
      match Js.Opt.to_option (Dom_html.document##getElementById (Js.string "btn-pause")) with
      | Some e -> Js.Opt.get (Dom_html.CoerceTo.button e) (fun () -> assert false)
      | None ->
          let open Js_of_ocaml_tyxml.Tyxml_js in
          let b = Html.button ~a:[ Html.a_id "btn-pause"; Html.a_class ["btn"; "btn--pause"] ] [ Html.txt "" ] in
          let dom = Js_of_ocaml_tyxml.Tyxml_js.To_dom.of_button b in
          Dom.appendChild (Dom_html.document##.body :> Dom.node Js.t) (dom :> Dom.node Js.t);
          dom
    in
    let open Js_of_ocaml_lwt in
    let update_icon () =
      (* İkonu CSS sınıflarıyla değiştiriyoruz *)
      if !(Config.paused) then btn##.classList##add (Js.string "is-paused")
      else btn##.classList##remove (Js.string "is-paused")
    in
    update_icon ();
    Lwt.async (fun () ->
      Lwt_js_events.clicks btn (fun _ _ ->
        if !(Runtime.game_started) then (
          Config.paused := not !(Config.paused);
          if !(Config.paused) then Timer.pause () else Timer.resume ();
          update_icon ()
        ); Lwt.return_unit))

  let ensure_settings_panel () =
    match Js.Opt.to_option (Dom_html.document##getElementById (Js.string "settings-panel")) with
    | Some e -> Js.Opt.get (Dom_html.CoerceTo.div e) (fun () -> assert false)
    | None ->
        let dv = Dom_html.createDiv Dom_html.document in
        dv##.id := Js.string "settings-panel";
        dv##.className := Js.string "settings is-hidden";
        Dom.appendChild (Dom_html.document##.body :> Dom.node Js.t) (dv :> Dom.node Js.t);
        dv

  let init_menu_button () =
    let btn =
      match Js.Opt.to_option (Dom_html.document##getElementById (Js.string "btn-menu")) with
      | Some e -> Js.Opt.get (Dom_html.CoerceTo.button e) (fun () -> assert false)
      | None ->
          let open Js_of_ocaml_tyxml.Tyxml_js in
          let b = Html.button ~a:[ Html.a_id "btn-menu"; Html.a_title "Settings"; Html.a_class ["btn"; "btn--menu"] ] [ Html.txt "" ] in
          let dom = Js_of_ocaml_tyxml.Tyxml_js.To_dom.of_button b in
          Dom.appendChild (Dom_html.document##.body :> Dom.node Js.t) (dom :> Dom.node Js.t);
          dom
    in
    let panel = ensure_settings_panel () in
    (* İçeride ayrıca bir Close butonu *)
    (match Js.Opt.to_option (panel##querySelector (Js.string ".settings__close")) with
     | Some _ -> ()
     | None ->
         let closeb = Dom_html.createButton Dom_html.document in
         closeb##.className := Js.string "settings__close";
         closeb##.title := Js.string "Close";
         Dom.appendChild (panel :> Dom.node Js.t) (closeb :> Dom.node Js.t));

    let close_btn = Js.Opt.get (panel##querySelector (Js.string ".settings__close")) (fun () -> assert false) in
    let set_open open_ =
      if open_ then (panel##.classList##remove (Js.string "is-hidden"); btn##.classList##add (Js.string "is-open"))
      else (panel##.classList##add (Js.string "is-hidden"); btn##.classList##remove (Js.string "is-open"))
    in
    (* İlk kez açılıyorsa sliderları oluştur *)
    if panel##.childNodes##.length <= 1 then Settings.make_sliders panel;

    let open Js_of_ocaml_lwt in
    Lwt.async (fun () ->
      Lwt_js_events.clicks btn (fun _ _ ->
        let now_open =
          if Js.to_bool (panel##.classList##contains (Js.string "is-hidden"))
          then true else false
        in
        set_open now_open; Lwt.return_unit));

    Lwt.async (fun () ->
      Lwt_js_events.clicks (Js.Opt.get (Dom_html.CoerceTo.button close_btn) (fun () -> assert false))
        (fun _ _ -> set_open false; Lwt.return_unit));
    ()

  (* Play overlay: arka plan blur, Play’e basınca başlar *)
  let ensure_play_overlay () =
    match Js.Opt.to_option (Dom_html.document##getElementById (Js.string "play-overlay")) with
    | Some e -> Js.Opt.get (Dom_html.CoerceTo.div e) (fun () -> assert false)
    | None ->
        let open Js_of_ocaml_tyxml.Tyxml_js in
        let overlay =
          Html.div ~a:[ Html.a_id "play-overlay"; Html.a_class ["overlay"; "overlay--play"] ] [
            Html.div ~a:[ Html.a_class ["overlay__box"] ] [
              Html.button ~a:[ Html.a_id "btn-play"; Html.a_class ["btn"; "btn--primary"] ] [ Html.txt "Play" ]
            ]
          ]
        in
        let dom = Js_of_ocaml_tyxml.Tyxml_js.To_dom.of_div overlay in
        Dom.appendChild (Dom_html.document##.body :> Dom.node Js.t) (dom :> Dom.node Js.t);
        dom

  let show_play_blur () =
    (match Js.Opt.to_option (Dom_html.document##getElementById (Js.string "sim")) with
     | Some sim -> sim##.classList##add (Js.string "is-blurred")
     | None -> ())
  let hide_play_blur () =
    (match Js.Opt.to_option (Dom_html.document##getElementById (Js.string "sim")) with
     | Some sim -> sim##.classList##remove (Js.string "is-blurred")
     | None -> ())

  let init_play (on_play: unit -> unit) =
    let overlay = ensure_play_overlay () in
    show_play_blur ();
    let btn = Js.Opt.get (Dom_html.document##getElementById (Js.string "btn-play")) (fun () -> assert false) in
    let open Js_of_ocaml_lwt in
    Lwt.async (fun () ->
      Lwt_js_events.clicks (Js.Opt.get (Dom_html.CoerceTo.button btn) (fun () -> assert false))
        (fun _ _ ->
           overlay##.classList##add (Js.string "is-hidden");
           hide_play_blur ();
           on_play ();
           Lwt.return_unit))
end

module%client Game = struct
  open Js_of_ocaml

  let start () =
    if not !(Runtime.game_started) then (
      Runtime.game_started := true;
      Difficulty.start ();
      Stats.refresh ();
      Input.install ();
      Timer.start ();
      Collider.start ();
      Random.self_init ();
      let w = float_of_int Dom_html.window##.innerWidth
      and h = float_of_int Dom_html.window##.innerHeight in
      for i=1 to !(Params.initial_creets) do
        let x = Random.float (max 1. (w -. Const.base_size)) in
        let y = Random.float (max 1. (h -. Const.base_size)) in
        let c = Creet.create ~id:i ~x ~y () in
        World.add c; Movement.start c; Movement.start_reproduction c;
      done;
    )

  let replay () =
    (match Js.Opt.to_option (Dom_html.document##getElementById (Js.string "gameover")) with
     | Some g -> Js.Opt.iter g##.parentNode (fun p -> ignore (Dom.removeChild p (g :> Dom.node Js.t)))
     | None -> ());
    Session.epoch := !Session.epoch + 1;
    World.all () |> List.iter (fun c ->
      Js.Opt.iter c.Creet.elt##.parentNode (fun p -> ignore (Dom.removeChild p (c.Creet.elt :> Dom.node Js.t))));
    World.creets := [];
    Stats.dead_total := 0; Stats.refresh ();
    Config.paused := false; Runtime.game_over := false; Runtime.game_started := true;
    Difficulty.base := 1.0; Timer.start (); Collider.start ();
    let w = float_of_int Dom_html.window##.innerWidth and h = float_of_int Dom_html.window##.innerHeight in
    Random.self_init ();
    for i=1 to !(Params.initial_creets) do
      let x = Random.float (max 1. (w -. Const.base_size)) in
      let y = Random.float (max 1. (h -. Const.base_size)) in
      let c = Creet.create ~id:i ~x ~y () in
      World.add c; Movement.start c; Movement.start_reproduction c;
    done
end

(* ─────────────────────────────────────────────────────────────────────────── *)
let%shared () =
  App.register ~service:main_service (fun () () ->
    Lwt.return
      Eliom_content.Html.F.(
        html
          (head
             (title (txt "h42n42"))
             [ css_link
                 ~uri:(make_uri
                         ~service:(Eliom_service.static_dir ())
                         ["css"; "h42n42.css"])
                 () ])
          (body [ div ~a:[a_id "sim"] [] ]))
  )

(* ─────────────────────────────────────────────────────────────────────────── *)
let%client _ =
  Lwt.async (fun () ->
    let%lwt _ = Js_of_ocaml_lwt.Lwt_js_events.onload () in
    Overlay.init_bands ();
    Stats.refresh ();
    Overlay.init_pause_button ();
    Overlay.init_menu_button ();
    Callbacks.on_replay := (fun () -> Game.replay ());

    (* Uygulama Play overlay ile başlar *)
    Overlay.init_play (fun () -> Game.start ());
    Lwt.return_unit
  )
