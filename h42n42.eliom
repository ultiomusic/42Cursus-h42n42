    (match Js.Opt.to_option (Dom_html.document##getElementById (Js.string "river")) with
     | Some d ->
         d##.style##.height := Js.string (Printf.sprintf "%dpx" (int_of_float !(Params.river_h)));
         d##.style##.top    := Js.string "0px";
         d##.style##.bottom := Js.string "auto"
     | None -> ());
    (match Js.Opt.to_option (Dom_html.document##getElementById (Js.string "hospital")) with
     | Some d ->
         d##.style##.height := Js.string (Printf.sprintf "%dpx" (int_of_float !(Params.hospital_h)));
         d##.style##.top    := Js.string "auto";
         d##.style##.bottom := Js.string "0px"
     | None -> ())

  let create_if_missing id classes =
    match Js.Opt.to_option (Dom_html.document##getElementById (Js.string id)) with
    | Some _ -> ()
    | None ->
        let d = Dom_html.createDiv Dom_html.document in
        d##.id := Js.string id; d##.className := Js.string classes;
        d##.style##.position := Js.string "absolute";
        let sim = Dom_html.getElementById "sim" in
        Dom.appendChild (sim :> Dom.node Js.t) (d :> Dom.node Js.t)

  let init () =
    create_if_missing "river" "band band--river";
    create_if_missing "hospital" "band band--hospital";
    set_heights ();
    (match Js.Opt.to_option (Dom_html.document##getElementById (Js.string "river")) with
     | Some r -> r##.style##.zIndex := Js.string "3" | None -> ());
    (match Js.Opt.to_option (Dom_html.document##getElementById (Js.string "hospital")) with
     | Some h -> h##.style##.zIndex := Js.string "2" | None -> ());
end

